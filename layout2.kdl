// Zellij layout for MTGJSON Rust Parallelization
// Launch with: zellij --layout layout2_fixed.kdl attach -c mtgjson-parallel
// Purpose: Coordinate parallel development to fix 31 compilation errors

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="WS1-GitHub" focus=true {
        pane {
            name "GitHub Module Implementation"
            command "bash"
            args "-c" "git checkout feature/gh 2>/dev/null || git checkout -b feature/gh; clear; echo '===================================='; echo '# Workstream 1: GitHub Module Implementation'; echo '===================================='; echo ''; echo 'Branch: feature/gh'; echo 'Effort: 8 hours'; echo ''; echo 'Files to create:'; echo '  - src/providers/github/mod.rs'; echo '  - src/providers/github/boosters.rs'; echo '  - src/providers/github/decks.rs'; echo '  - src/providers/github/sealed.rs'; echo '  - src/providers/github/card_sealed_products.rs'; echo '  - src/providers/github/mtgsqlite.rs'; echo ''; echo 'Template: Follow EdhrecProviderCardRanks pattern'; echo ''; echo 'No conflicts expected - completely isolated work'; echo ''; echo 'Agent ready for WS1 tasks'; exec bash"
        }
    }

    tab name="WS2-PyO3" {
        pane {
            name "PyO3 v0.22 API Migration"
            command "bash"
            args "-c" "git checkout feature/pyo3 2>/dev/null || git checkout -b feature/pyo3; clear; echo '===================================='; echo '# Workstream 2: PyO3 API Migration'; echo '===================================='; echo ''; echo 'Branch: feature/pyo3'; echo 'Effort: 12 hours'; echo ''; echo 'API Changes Required:'; echo '  PyList::new → PyList::new_bound'; echo '  PyDict::new → PyDict::new_bound'; echo '  PySet::empty → PySet::new_bound'; echo '  PyModule::import → PyModule::import_bound'; echo '  CString::new() → CString::new(\"\")'; echo '  py.run() → PyModule::from_code_bound'; echo ''; echo 'Files to update (20+):'; echo '  - src/providers/third_party/*.rs'; echo '  - src/providers/cardmarket/monolith.rs'; echo '  - src/providers/scryfall/monolith.rs'; echo '  - src/classes/card.rs'; echo '  - src/builders/price_builder.rs'; echo ''; echo 'Conflicts possible: parallel_call.rs, foreign_data.rs'; echo ''; echo 'Agent ready for WS2 tasks'; exec bash"
        }
    }

    tab name="WS3-Types" {
        pane {
            name "Type & Method Signature Fixes"
            command "bash"
            args "-c" "git checkout feature/type-fix 2>/dev/null || git checkout -b feature/type-fix; clear; echo '===================================='; echo '# Workstream 3: Type & Method Fixes'; echo '===================================='; echo ''; echo 'Branch: feature/type-fix'; echo 'Effort: 6 hours'; echo ''; echo 'Key Fixes:'; echo '  - download_all_pages() - add py, url, params args'; echo '  - download_cards() - add py, set_code args'; echo '  - Fix type annotations in parallel_call.rs'; echo ''; echo 'Target Files:'; echo '  - src/builders/set_builder.rs (lines 172, 1522)'; echo '  - src/builders/parallel_call.rs'; echo ''; echo 'Example fix:'; echo '  BEFORE: provider.download_all_pages()?'; echo '  AFTER:  provider.download_all_pages(py, url, Some(params))?'; echo ''; echo 'Conflicts possible: parallel_call.rs (with WS2)'; echo ''; echo 'Agent ready for WS3 tasks'; exec bash"
        }
    }

    tab name="WS4-Lifetimes" {
        pane {
            name "Lifetime & Memory Safety Fixes"
            command "bash"
            args "-c" "git checkout feature/life-fix 2>/dev/null || git checkout -b feature/life-fix; clear; echo '===================================='; echo '# Workstream 4: Lifetime Fixes'; echo '===================================='; echo ''; echo 'Branch: feature/life-fix'; echo 'Effort: 4 hours'; echo ''; echo 'Focus: Fix Bound<_, PyDict> lifetimes'; echo ''; echo 'Target File:'; echo '  - src/classes/foreign_data.rs'; echo ''; echo 'Issues to fix:'; echo '  - to_dict() lifetime annotations'; echo '  - to_dict_bound() implementation'; echo '  - PyDict operations using new_bound'; echo ''; echo 'Conflicts possible: foreign_data.rs (with WS2)'; echo ''; echo 'Agent ready for WS4 tasks'; exec bash"
        }
    }

    tab name="WS5-API" {
        pane {
            name "High-Level Python API (Post-Compilation)"
            command "bash"
            args "-c" "git checkout feature/api-cli 2>/dev/null || git checkout -b feature/api-cli; clear; echo '===================================='; echo '# Workstream 5: High-Level API'; echo '===================================='; echo ''; echo 'Branch: feature/api-cli'; echo 'Effort: 8 hours'; echo ''; echo '⚠️  BLOCKED: Must wait for WS1-4 completion'; echo ''; echo 'Functions to add to src/lib.rs:'; echo '  - build_single_set(set_code, include_extras)'; echo '  - build_multiple_sets(set_codes)'; echo '  - build_all_sets()'; echo '  - build_prices_only(set_code)'; echo '  - write_set_to_file(set_data, path)'; echo '  - generate_compiled_outputs()'; echo '  - generate_file_hashes()'; echo ''; echo 'Requirements:'; echo '  ✅ Compilation must succeed first'; echo '  ✅ All PyO3 bindings working'; echo '  ✅ Integration tests passing'; echo ''; echo 'Agent ready for WS5 tasks (after merge)'; exec bash"
        }
    }

    tab name="Coordination" {
        pane split_direction="vertical" {
            pane size="70%" {
                name "Dashboard"
                command "bash"
                args "-c" "echo 'Starting MTGJSON coordination dashboard...'; sleep 1; ./coordination/workstream-dashboard.sh 2>/dev/null || (echo 'Dashboard not found. Creating fallback monitoring...'; while true; do clear; echo '=== MTGJSON Parallelization Status ==='; echo ''; echo 'Compilation Errors:'; cargo check 2>&1 | grep -c 'error\\[' | xargs echo '  Current:'; echo '  Target: 0'; echo ''; echo 'Workstream Branches:'; git branch | grep feature/ | sed 's/^/  /'; echo ''; echo 'Recent Commits:'; git log --oneline -5 --all --decorate | sed 's/^/  /'; echo ''; sleep 10; done)"
            }
            pane size="30%" split_direction="horizontal" {
                pane {
                    name "Error Count"
                    command "watch"
                    args "-n" "30" "echo 'MTGJSON Compilation Metrics:'; echo ''; cargo check 2>&1 | grep -c 'error\\[' | xargs echo 'Errors:'; cargo check 2>&1 | grep -c 'warning:' | xargs echo 'Warnings:'; echo ''; echo 'PyO3 Migration Progress:'; rg 'PyList::new\\(' --type rust 2>/dev/null | wc -l | xargs echo '  Old PyList::new:'; rg 'PyList::new_bound\\(' --type rust 2>/dev/null | wc -l | xargs echo '  New PyList::new_bound:'; echo ''; echo 'GitHub Module:'; ls -la src/providers/github/ 2>/dev/null | wc -l | xargs echo '  Files created:'"
                }
                pane {
                    name "Branch Status"
                    command "watch"
                    args "-n" "5" "echo 'Active Branches:'; git branch | grep -E 'feature/|finish_patch' | sed 's/^/  /'; echo ''; git status --short | head -10; echo ''; echo 'Current:'; git branch --show-current"
                }
            }
        }
    }

    tab name="Monitor" {
        pane split_direction="vertical" {
            pane size="50%" {
                name "Compilation Monitor"
                command "bash"
                args "-c" "echo 'Monitoring MTGJSON Rust compilation...'; echo 'Target: 0 errors (from 31)'; echo ''; while true; do echo '=== Compilation Check ==='; cargo check 2>&1 | grep -E 'error\\[|error:' | head -15; echo ''; echo 'Error count:' $(cargo check 2>&1 | grep -c 'error\\['); echo 'Timestamp:' $(date '+%H:%M:%S'); echo '---'; sleep 20; done"
            }
            pane size="50%" split_direction="horizontal" {
                pane {
                    name "File Activity"
                    command "watch"
                    args "-n" "5" "echo 'Recently Modified Files:'; find src/ -name '*.rs' -mmin -10 2>/dev/null | head -15"
                }
                pane {
                    name "Key Files"
                    command "bash"
                    args "-c" "watch -n 10 \"echo 'Key File Status:'; echo ''; echo 'GitHub Module:'; ls -la src/providers/github/*.rs 2>/dev/null | wc -l | xargs echo '  Files:'; echo ''; echo 'Critical Files:'; ls -la src/builders/parallel_call.rs 2>/dev/null && echo '  ✓ parallel_call.rs' || echo '  ✗ parallel_call.rs'; ls -la src/classes/foreign_data.rs 2>/dev/null && echo '  ✓ foreign_data.rs' || echo '  ✗ foreign_data.rs'; ls -la src/builders/set_builder.rs 2>/dev/null && echo '  ✓ set_builder.rs' || echo '  ✗ set_builder.rs'\""
                }
            }
        }
    }

    tab name="Commands" {
        pane {
            name "MTGJSON Quick Commands"
            command "bash"
            args "-c" "cat << 'EOF'\n========================================\nMTGJSON Rust Parallelization Commands\n========================================\n\nSETUP:\n  # Create all workstream branches\n  ./coordination/create-workstream-branches.sh\n\n  # Check out specific workstream\n  git checkout feature/gh              # WS1\n  git checkout feature/pyo3            # WS2\n  git checkout feature/type-fix        # WS3\n  git checkout feature/life-fix        # WS4\n  git checkout feature/api-cli         # WS5\n\nSTATUS:\n  # Check all workstreams\n  ./coordination/sync-status.sh\n\n  # Interactive dashboard\n  ./coordination/workstream-dashboard.sh\n\n  # Check compilation\n  cargo check 2>&1 | grep -c 'error\\['\n\nDEVELOPMENT:\n  # WS1: Create GitHub module\n  mkdir -p src/providers/github\n  touch src/providers/github/{mod,boosters,decks,sealed,card_sealed_products,mtgsqlite}.rs\n\n  # WS2: Fix PyO3 calls\n  rg 'PyList::new\\(' --type rust -l    # Find old API\n  rg 'PyDict::new\\(' --type rust -l\n  rg 'PySet::empty\\(' --type rust -l\n\n  # WS3: Fix method signatures\n  cargo check 2>&1 | grep 'this method takes'\n\n  # WS4: Fix lifetimes\n  cargo check 2>&1 | grep 'lifetime'\n\nTESTING:\n  # Test compilation\n  cargo build\n\n  # Test specific module\n  cargo check --lib\n\n  # Run tests\n  cargo test\n\nMERGE:\n  # When all complete\n  ./coordination/merge-workstreams.sh\n\n  # Manual merge\n  git checkout main\n  git merge feature/gh\n  git merge feature/pyo3\n  git merge feature/type-fix\n  git merge feature/life-fix\n  cargo build  # Should succeed!\n  git merge feature/api-cli\n\nMETRICS:\n  # Count errors\n  cargo check 2>&1 | grep -c 'error\\['\n\n  # Count warnings\n  cargo check 2>&1 | grep -c 'warning:'\n\n  # PyO3 migration progress\n  echo 'Old API calls:' $(rg 'PyList::new\\(' --type rust | wc -l)\n  echo 'New API calls:' $(rg 'PyList::new_bound\\(' --type rust | wc -l)\n\nHELP:\n  # View epic details\n  less EPIC.md\n\n  # View parallelization strategy\n  less ../PARALLELIZATION_STRATEGY.md\n\n  # Coordination tools help\n  less coordination/README.md\n\nEOF\nexec bash"
        }
    }

    tab name="Conflicts" {
        pane {
            name "Conflict Resolution Guide"
            command "bash"
            args "-c" "cat << 'EOF'\n========================================\nPotential Merge Conflicts\n========================================\n\nEXPECTED CONFLICTS:\n\n1. src/builders/parallel_call.rs\n   - Modified by: WS2 (PyO3 updates) & WS3 (Type fixes)\n   - Resolution: Keep both sets of changes\n\n   Example:\n   <<<<<<< HEAD (WS2)\n   let py_list = PyList::new_bound(py, items);  // PyO3 update\n   =======\n   provider.download_all_pages(py, url, params)?;  // Type fix\n   >>>>>>> feature/type-fix\n\n   KEEP BOTH - they fix different issues\n\n2. src/classes/foreign_data.rs\n   - Modified by: WS2 (PyO3 updates) & WS4 (Lifetime fixes)\n   - Resolution: Keep both sets of changes\n\n   Example:\n   <<<<<<< HEAD (WS2)\n   let dict = PyDict::new_bound(py);  // PyO3 update\n   =======\n   pub fn to_dict<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {  // Lifetime fix\n   >>>>>>> feature/life-fix\n\n   KEEP BOTH - complementary fixes\n\nNO CONFLICTS EXPECTED:\n- WS1 (GitHub module) - All new files\n- WS5 (High-level API) - Only after merge\n\nRESOLUTION STEPS:\n\n1. When conflict occurs:\n   git status                    # See conflicted files\n\n2. Open conflicted file and look for:\n   <<<<<<< HEAD\n   [current branch changes]\n   =======\n   [incoming branch changes]\n   >>>>>>> branch-name\n\n3. For parallel_call.rs and foreign_data.rs:\n   - Remove conflict markers\n   - Keep BOTH sets of changes\n   - They address different issues\n\n4. After resolving:\n   git add [resolved-file]\n   git merge --continue\n\n5. Test compilation:\n   cargo check\n\nPREVENTION:\n\nTo minimize conflicts:\n- WS2 developer: Focus on PyO3 API replacements only\n- WS3 developer: Focus on method signatures only\n- WS4 developer: Focus on lifetime annotations only\n- Communicate if touching same file\n\nABORT IF NEEDED:\n  git merge --abort\n  git checkout main\n  git reset --hard origin/main\n\nEOF\nexec bash"
        }
    }
}
